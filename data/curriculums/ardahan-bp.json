            { "week": 10, "topic": "Çok Boyutlu Diziler & Matrisler", "goal": "İki boyutlu veri dizilimleri" },
            { "week": 11, "topic": "Fonksiyonlar / Metotlar", "goal": "Modüler kod yazımı ve parametre kullanımı" },
            { "week": 12, "topic": "Geriye Değer Döndüren Metotlar", "goal": "return ifadesi ve scope mantığı" },
            { "week": 13, "topic": "String İşlemleri & Hazır Metotlar", "goal": "Metinsel verileri işleme teknikleri" },
            { "week": 14, "topic": "Hata Yönetimi (Try-Catch)", "goal": "Çalışma zamanı hatalarını yakalama" }
          ]
