          "topics": ["Algoritma ve Akış Şemaları", "C# Temel Yapı ve Değişkenler", "Karar Yapıları (if-else, switch)", "Döngüler (for, while)", "Fonksiyonlar ve Metotlar"],
          "weeklyPlan": [
            { "week": 1, "topic": "Algoritma Mantığı ve Akış Diyagramları", "goal": "Problemi adımlara bölme becerisi kazanma" },
