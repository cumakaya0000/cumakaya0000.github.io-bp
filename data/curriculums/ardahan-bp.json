            { "week": 12, "topic": "Kısıtlamalar (Constraints): Primary Key, Foreign Key, Unique", "goal": "Veri bütünlüğü sağlama" },
            { "week": 13, "topic": "Görünümler (Views)", "goal": "Sanal tablolar oluşturma" },
            { "week": 14, "topic": "İndeksler ve Performans", "goal": "Sorgu hızlandırma teknikleri" }
